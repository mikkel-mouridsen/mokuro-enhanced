# This .dockerignore is at the root level
# The actual build context is ./packages - see packages/.dockerignore

# Development and reference directories
inspiration/
example_data/

# Dependencies
node_modules
npm-debug.log

# Build output
dist
*.tsbuildinfo

# User data - NEVER include in Docker image
uploads
temp

# Tests
coverage
*.spec.ts
test

# IDE
.idea
.vscode
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Git
.git
.gitignore
.gitattributes

# Environment - NEVER include in Docker image
.env
.env.*

# Logs
logs
*.log

# Documentation
README.md
*.md
!packages/*/README.md

# CI/CD
.github

