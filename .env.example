# ===========================================
# Mokuro Enhanced - Environment Configuration
# ===========================================
# Copy this file to .env and update with your actual values

# ===========================================
# SECURITY (REQUIRED)
# ===========================================
# JWT Secret for authentication - CHANGE THIS IN PRODUCTION!
# Generate a secure random string (32+ characters recommended)
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRES_IN=7d

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# PostgreSQL connection details
# These match the docker-compose.yml defaults
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=mokuro_enhanced

# ===========================================
# REDIS CONFIGURATION
# ===========================================
# Redis connection for background job queue
REDIS_HOST=redis
REDIS_PORT=6379

# ===========================================
# STORAGE CONFIGURATION
# ===========================================
# Storage type: 'local' or 's3'
STORAGE_TYPE=local

# Local storage path (when STORAGE_TYPE=local)
STORAGE_PATH=/data/uploads

# S3 Storage Configuration (when STORAGE_TYPE=s3)
# Uncomment and configure if using AWS S3 or compatible storage
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name

# ===========================================
# SERVER CONFIGURATION
# ===========================================
# Node environment
NODE_ENV=production

# Server port
PORT=3000

# ===========================================
# CORS CONFIGURATION
# ===========================================
# Allowed origins for CORS (comma-separated for multiple)
# Examples:
# - Local development: http://localhost:5173
# - Production domain: https://your-domain.com
# - Multiple: http://localhost:5173,https://your-domain.com
CORS_ORIGIN=http://localhost:5173

# ===========================================
# WORKER CONFIGURATION (Python OCR)
# ===========================================
# Temporary directory for OCR processing
TEMP_DIR=/data/temp

# Backend API URL (worker -> server communication)
BACKEND_URL=http://server:3000

# Mokuro OCR model
MOKURO_MODEL=kha-white/manga-ocr-base

# Force CPU usage (set to "true" to disable GPU)
FORCE_CPU=false

# GPU Configuration (for NVIDIA GPUs)
# These are automatically set by docker-compose if you have nvidia-docker
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
